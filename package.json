{
  "name": "ai-workspace-v2",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "ai-workspace-v2": "./bin/start.ts"
  },
  "scripts": {
    "dev:hot": "bun --bun bin/start.ts --hot",
    "start": "bun --bun bin/start.ts",
    "lint": "bun check && bun --bun eslint src/",
    "test": "bun run test:node && bun run test:dom",
    "test:node": "bun test --parallel src/__tests__/api src/__tests__/app src/__tests__/lib",
    "test:dom": "bun test --parallel --preload ./src/test-setup-dom.ts src/__tests__/components src/__tests__/hooks",
    "web-server": "bun run bin/web-server.ts",
    "chat-server": "bun run bin/chat-server.ts",
    "bench": "bun --bun bin/bench.ts",
    "bench:execute": "bun --bun bin/bench-execute.ts",
    "harvest-lessons": "bun --bun bin/harvest-lessons.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@slack/bolt": "^4.7.2",
    "@tanstack/react-router": "^1.170.46",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "web-push": "^3.6.7",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^21.0.4",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "bun-plugin-tailwind": "^0.1.2",
    "eslint": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "^8.5.8",
    "postcss-load-config": "^6.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.57.1"
  },
  "patchedDependencies": {
    "@tanstack/router-core@1.171.39": "patches/@tanstack%2Frouter-core@1.171.39.patch"
  }
}
